# ---------------------------------------------------------------------------
# Data Lake
# ---------------------------------------------------------------------------
# Ruta base del lake: adentro van landing/, bronze/, silver/, gold/,
# quarantine/ y checkpoints/.
#   Local / Docker: ./data/datalake   (en Docker se pisa por /app/data/datalake)
#   Colab:          /content/drive/MyDrive/cloud_provider_challenge_dataset_v1/datalake
DATALAKE_PATH=./data/datalake

# ---------------------------------------------------------------------------
# Serving: local (Cassandra en Docker) | astra (AstraDB en la nube)
# ---------------------------------------------------------------------------
SERVING_TARGET=local
CASSANDRA_KEYSPACE=cloud_analytics

# --- SERVING_TARGET=local ---
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042

# --- SERVING_TARGET=astra ---
ASTRA_DB_APPLICATION_TOKEN=
# https://<db_id>-<region>.apps.astra.datastax.com
# Con el endpoint y el token, el secure connect bundle se descarga solo a secrets/.
# Es necesario para poder correr CQL
ASTRA_DB_API_ENDPOINT=
# Se puede usar un bundle propio si ya hay uno descargado
# ASTRA_DB_SECURE_BUNDLE_PATH=./secrets/secure-connect-bundle.zip
